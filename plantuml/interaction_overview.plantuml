@startuml
allowmixing
' !include "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons/font-awesome-5/user_doctor.puml"

' title diagramm
' ICON_DOC(doctor,LIVE,user_doctor,black) #RoyalBlue

' stethoscope	GOV_STETHOSCOPE
' balance_scale	FA5_BALANCE_SCALE
' flask	FA5_FLASK
' hand_holding_medical	FA5_HAND_HOLDING_MEDICAL
' heartbeat	FA5_HEARTBEAT
' comment_medical	FA5_COMMENT_MEDICAL
' clinic_medical	FA5_CLINIC_MEDICAL


skinparam componentStyle uml2
skinparam packageStyle rectangle

skinparam borderColor #555555
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 4
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

!define COLOR_EMED_FA  #e97232bd

' Styling für UML-Komponenten und Schnittstellen (Klassischer UML-Stil)
skinparam component {
  BackgroundColor COLOR_EMED_FA
  'BorderColor #0366D6
  'FontColor #000000
  'FontStyle bold
}

skinparam interface {
  'BackgroundColor #FFFFFF
  'BorderColor #005CC5
}

left to right direction

title REST-Schnittstellen: [base]


interface "/List" as List_type {
  «GET» ?code=[code]&_include=* [GDA, PAT] 
  «GET» ?code=[code]&_sort=-date&_count=1&_include=* [GDA, PAT]
  «POST» $list-write [GDA]
}

interface "/List/[id]" as List_instance { 
  «DELETE» [PAT]
}

interface "/Condition/[id]" as ICondition_instance {
  «POST» $delete [PAT]
  «POST» $storno [GDA]
} 

interface "/Condition" as ICondition_type {
  «POST» [GDA]
  «GET» [GDA, PAT]
} 

interface "/Procedure/[id]" as IProcedure_instance {
  «POST» $delete [PAT]
  «POST» $storno [GDA]
} 

interface "/Procedure" as IProcedure_type {
  «POST» [GDA]
  «GET» [GDA, PAT]
} 

interface "/AllergyIntolerance/[id]" as IAllergyIntolerance_instance {
  «POST» $delete [PAT]
  «POST» $storno [GDA]
} 

interface "/AllergyIntolerance" as IAllergyIntolerance_type {
  «POST» [GDA]
  «GET» [GDA, PAT]
} 

' --- SYSTEMKOMPONENTE (ZENTRALER SERVER) ---

component "ELGA\ne-Diagnose" as Server {
  port "List" as p1
  port "Condition" as p2
  port "Procedure" as p3
  port "AllergyIntolerance" as p4
}

p1 -up- List_type
p1 -up- List_instance
p2 -up- ICondition_type
p2 -up- ICondition_instance
p3 -up- IProcedure_type
p3 -up- IProcedure_instance
p4 -up- IAllergyIntolerance_type
p4 -up- IAllergyIntolerance_instance

legend right
  **Legende Berechtigungen:**
  [GDA] = Gesundheitsdiensteanbieter
  [PAT] = PATIENT: ELGA-Teilnehmer
end legend

@enduml