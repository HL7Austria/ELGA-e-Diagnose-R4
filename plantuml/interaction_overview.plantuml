@startuml
allowmixing
' !include "https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v3.0.0/icons/font-awesome-5/user_doctor.puml"

' title diagramm
' ICON_DOC(doctor,LIVE,user_doctor,black) #RoyalBlue

' stethoscope	GOV_STETHOSCOPE
' balance_scale	FA5_BALANCE_SCALE
' flask	FA5_FLASK
' hand_holding_medical	FA5_HAND_HOLDING_MEDICAL
' heartbeat	FA5_HEARTBEAT
' comment_medical	FA5_COMMENT_MEDICAL
' clinic_medical	FA5_CLINIC_MEDICAL


skinparam componentStyle uml2
skinparam packageStyle rectangle

skinparam borderColor #555555
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 4
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam defaultFontColor #000000

!define COLOR_EMED_FA  #e97232bd

' Styling für UML-Komponenten und Schnittstellen (Klassischer UML-Stil)
skinparam component {
  BackgroundColor COLOR_EMED_FA
  'BorderColor #0366D6
  'FontColor #000000
  'FontStyle bold
}

skinparam interface {
  'BackgroundColor #FFFFFF
  'BorderColor #005CC5
}

left to right direction

title REST-Schnittstellen: https://[server]


interface "/Patient/[id]/List/" as List_type {
  «GET» ?code=[code]&_include=* [GDA, PAT] 
  «GET» ?code=[code]&_sort=-date&_count=1&_include=* [GDA, PAT]
  «POST» $list-write [GDA]
}

interface "/Patient/[id]/List/[rid]" as List_instance { 
  «DELETE» [PAT]
}

interface "/Patient/[id]/Condition/" as ICondition {
  «POST» [GDA]
  «POST» $delete [PAT]
  «POST» $storno [GDA]
  «GET» [GDA, PAT]
} 

interface "/Patient/[id]/Procedure/" as IProcedure {
  «POST» [GDA]
  «POST» $delete [PAT]
  «POST» $storno [GDA]
  «GET» [GDA, PAT]
} 

interface "/Patient/[id]/AllergyIntolerance/" as IAllergyIntolerance {
  «POST» [GDA]
  «POST» $delete [PAT]
  «POST» $storno [GDA]
  «GET» [GDA, PAT]
} 

' --- SYSTEMKOMPONENTE (ZENTRALER SERVER) ---

component "ELGA\ne-Diagnose" as Server {
  port "List (type level)" as p1
  port "List (instance level)" as p5
  port "Condition" as p2
  port "Procedure" as p3
  port "AllergyIntolerance" as p4
}

p1 -up- List_type
p5 -up- List_instance
p2 -up- ICondition
p3 -up- IProcedure
p4 -up- IAllergyIntolerance

legend right
  **Legende Berechtigungen:**
  [GDA] = Gesundheitsdiensteanbieter
  [PAT] = PATIENT: ELGA-Teilnehmer:in
end legend

' --- ARCHITEKTUR-NOTIZEN ---

' note bottom of Server
'   **UML 2.0 Component Specification**
'   Zentrales e-Medikations-System kapselt persistierte
'   Collection Bundles (v.1 / v.2) und Transaction Bundles.
' end note

' note right of IBundle
'   **Ressourcen-Kontext:**
'   Enthält MedicationRequest,
'   Patient, Practitioner.
' end note

@enduml