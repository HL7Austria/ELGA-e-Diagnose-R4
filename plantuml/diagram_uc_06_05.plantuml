@startuml

title Einträge aus einer Liste entfernen

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000
skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false
skinparam BoxPadding 20
skinparam BoxBorderColor #555555

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 0
  Padding 6
  FontColor #111827
  Shadowing false
}

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #0078D460
!define COLOR_GDA_2    #8764B860
!define COLOR_PATIENT  #00950560
!define COLOR_APO      #00B7C360
!define COLOR_DIAG_FA  #E9713280
!define COLOR_E_REZEPT #E7485660

!define COLOR_OK       #50E6FF25
!define COLOR_ERROR    #FF8C0035

actor GDA_1 as "GDA 1" COLOR_GDA_1
participant eDiag_FA as "e-Diagnose Fachanwendung" COLOR_DIAG_FA

autonumber

== Liste abrufen ==

activate GDA_1 COLOR_GDA_1

ref over GDA_1, eDiag_FA : [[interactions.html#list-read List-Read]]


note over GDA_1
GDA erhält die aktuelle Liste
im Collection Bundle
end note

== Listeneintrag entfernen ==

note over GDA_1
GDA wählt einen bestehenden
Listeneintrag aus
end note

GDA_1 -> GDA_1 : List.entry auswählen
GDA_1 -> GDA_1 : List.entry aus der Liste entfernen


== Persistieren der Änderungen ==

note over GDA_1
Unveränderte Ressourcen werden
nicht übertragen, sondern nur
über Referenzen adressiert.
end note

ref over GDA_1, eDiag_FA : [[interactions.html#list-write List-Write]]

ref over GDA_1, eDiag_FA
  [[uc-e-diag-06.html#sub-uc-e-diag-06-10-Diagnosen-Prozeduren-sowie-Allergien-und-Intoleranzen-bearbeiten Diagnosen, Prozeduren sowie Allergien und Intoleranzen bearbeiten]]

  meta.tag = #notrelevant
end ref

note over eDiag_FA
Listeneintrag erfolgreich entfernt.
Liste konsistent gespeichert.
end note

@enduml