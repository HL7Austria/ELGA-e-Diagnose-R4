@startuml

title Diagnosen, Prozeduren sowie Allergien und Intoleranzen stornieren

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000
skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false
skinparam BoxPadding 20
skinparam BoxBorderColor #555555

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 0
  Padding 6
  FontColor #111827
  Shadowing false
}

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #15608280
!define COLOR_GDA_2    #96607D80
!define COLOR_PATIENT  #196B2480
!define COLOR_DIAG_FA  #E9713280


!define COLOR_OK       #50E6FF25
!define COLOR_ERROR    #FF8C0035

actor GDA_1 as "GDA 1" COLOR_GDA_1
participant eDiag_FA as "e-Diagnose Fachanwendung" COLOR_DIAG_FA

autonumber
activate GDA_1 COLOR_GDA_1

== Einzelressourcen abrufen ==

GDA_1 -> eDiag_FA : Ressource lesen

eDiag_FA --> GDA_1 : Condition / Procedure / AllergyIntolerance

== Stornierung durchführen ==

GDA_1 -> GDA_1 : Ressource stornieren

note over GDA_1
Status auf den
ressourcenspezifischen
Stornierungsstatus setzen
(entered-in-error)
end note

== Persistieren ==

GDA_1 -> eDiag_FA : POST /[Condition|Procedure|AllergyIntolerance]/$storno

activate eDiag_FA COLOR_DIAG_FA

eDiag_FA -> eDiag_FA : Validierung der Stornierung

group Prüfung der Stornierung

    alt COLOR_OK Validierung erfolgreich

        eDiag_FA -> eDiag_FA : Ressource als storniert markieren

        note over eDiag_FA
        Ressource erfolgreich storniert.
        Sie bleibt historisch erhalten,
        wird aber nicht mehr aktiv verwendet.
        end note

        eDiag_FA --> GDA_1 : 200 OK

    else COLOR_ERROR Validierung fehlgeschlagen

        eDiag_FA --> GDA_1 : OperationOutcome

    end

end

deactivate eDiag_FA
deactivate GDA_1

@enduml