@startuml
skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 8
  Padding 6
  FontColor #111827
  Shadowing true
}

skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

skinparam BoxPadding 20
skinparam BoxBorderColor #555555

box "\n  GDA 1  " #9fbac4
  actor GDA_1 as "GDA 1"
end box

box "\n       e-Diagnose Fachanwendung      " #C48778
  participant eDiag_FA as "e-Diag FA"
end box

box "\n    GDA 2  " #beaebe
  actor GDA_2 as "GDA 2"
end box

box "\n Patient  " #bac38b
  actor Patient as "Patient"
end box


autonumber

 
== Read-to-Write durch GDA 1 ==
activate GDA_1
GDA_1 ->> eDiag_FA: POST $readtowrite

activate eDiag_FA
eDiag_FA -> eDiag_FA: Annahme: Prüfung auf bestehende Liste erfolgreich
eDiag_FA -> eDiag_FA: Collection Bundle zur Auslieferung erstellt\n(inkl. temporärem List.identifier "123")

eDiag_FA -->> GDA_1: Collection Bundle + List.identifier "123"
deactivate eDiag_FA

GDA_1 -> GDA_1: Einträge hinzufügen/ändern/entfernen

note over GDA_1
GDA 1 bearbeitet Liste
end note

== Read-to-Write durch GDA 2 ==

GDA_2 ->> eDiag_FA: POST $readtowrite
activate GDA_2

activate eDiag_FA
eDiag_FA -> eDiag_FA: Annahme: Prüfung auf bestehende Einträge in der Liste erfolgreich
eDiag_FA -> eDiag_FA: Collection Bundle zur Auslieferung erstellt\n(inkl. temporärem List.identifier "123")

eDiag_FA -->> GDA_2: Collection Bundle + List.identifier "123"
deactivate eDiag_FA

GDA_2 -> GDA_2: Einträge hinzufügen/ändern/entfernen

note over GDA_2
GDA 2 bearbeitet Liste
end note

== Write durch GDA 2 ==

GDA_2 ->> eDiag_FA: POST $write (Transaction Bundle + List.identifier "123")

activate eDiag_FA
eDiag_FA -> eDiag_FA: List.identifier "123" im Transaction Bundle ==\ntemporär gespeicherter List.identifier "123"
eDiag_FA -> eDiag_FA: Validierung der neuen Liste (keine unzulässigen Zustandsübergänge)
eDiag_FA -> eDiag_FA: Persistiert neue Version der Liste mit List.identifier "123"
eDiag_FA -> eDiag_FA: Löscht temporären List.identifier "123"
eDiag_FA -->> GDA_2: OK 
deactivate GDA_2

note over eDiag_FA
Liste wurde durch GDA 2 aktualisiert.
end note

deactivate eDiag_FA

== Write-Error für GDA 1 ==

GDA_1 ->> eDiag_FA: POST $write (Transaction Bundle + List.identifier "123")

activate eDiag_FA
eDiag_FA -> eDiag_FA: List.identifier "123" im TransactionBundle stimmt nicht\nmit temporär gespeicherten List.identifier überein\n(kein Eintrag vorhanden)
eDiag_FA -> eDiag_FA: Fachanwendung lehnt Speichern ab
eDiag_FA -->> GDA_1: Fehler (Konflikt)
deactivate GDA_1
note over eDiag_FA, GDA_1
Speichern der Liste wurde abgelehnt, der GDA 1 muss ein neues Read-to-Write ausführen.
end note

deactivate eDiag_FA

center footer Write-Error

@enduml