@startuml
title List-Read

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 8
  Padding 6
  FontColor #111827
  Shadowing true
}

skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #0078D460
!define COLOR_GDA_2    #8764B860
!define COLOR_PATIENT  #00950560
!define COLOR_APO      #00B7C360
!define COLOR_DIAG_FA  #f5a40360
!define COLOR_E_REZEPT #E7485660

!define COLOR_OK       #50E6FF25
!define COLOR_ERROR    #FF8C0035

actor GDA_1 as "GDA 1" COLOR_GDA_1
participant eDiag_FA as "e-Diagnose Fachanwendung" COLOR_DIAG_FA

autonumber
activate GDA_1 COLOR_GDA_1

== Liste abrufen ==

GDA_1 -> eDiag_FA: POST /[Condition|Procedure|AllergyIntolerance]/$list-read

activate GDA_1

note over GDA_1
Liste abrufen, 
mit der Intention zu schreiben
end note

activate eDiag_FA COLOR_DIAG_FA

eDiag_FA -> eDiag_FA: Prüfung auf bestehende Liste

alt Liste vorhanden
  eDiag_FA -> eDiag_FA: Stellt Collection-Bundle bereit:\nBedingung:\n- new|changed → unchanged\n- removed → entfernen
  eDiag_FA -> GDA_1: Collection-Bundle\n+ ETag für Optimistic Locking
else keine Liste vorhanden
  eDiag_FA -> eDiag_FA: Erzeugt leere Liste\n mit List.emptyReason = "notstarted"
  eDiag_FA -> GDA_1: Collection-Bundle (leere Liste)\n+ ETag für Optimistic Locking
  deactivate eDiag_FA
end

GDA_1 -> GDA_1: Einträge hinzufügen/ändern/entfernen

note over GDA_1
Nach der Bearbeitung der
Liste kann ein 
$list-write erfolgen.
end note

@enduml