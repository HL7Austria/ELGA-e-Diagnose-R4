@startuml
title List-Read

skinparam borderColor #000000
skinparam backgroundColor #f5f5f5
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #000000

skinparam note {
  BackgroundColor #e0e5f0-#d1d9e6
  BorderColor #8b95a5
  BorderThickness 1
  RoundCorner 8
  Padding 6
  FontColor #111827
  Shadowing true
}

skinparam HyperlinkColor #0000EE
skinparam HyperlinkUnderline false

skinparam sequence {
  ParticipantBorderColor #555555
  ParticipantBackgroundColor #ffffff
  ParticipantFontColor #000000
  ParticipantFontSize 14
  ParticipantPadding 20
  ArrowColor #111827
  ArrowThickness 1
  ArrowFontColor #000000
  ArrowFontSize 13
  GroupBorderColor #111827
  GroupBackgroundColor #eef2ff
  GroupBorderThickness 2
}

!define COLOR_GDA_1    #0078D460
!define COLOR_GDA_2    #8764B860
!define COLOR_PATIENT  #00950560
!define COLOR_APO      #00B7C360
!define COLOR_DIAG_FA  #f5a40360
!define COLOR_E_REZEPT #E7485660

!define COLOR_OK       #50E6FF25
!define COLOR_ERROR    #FF8C0035

actor GDA_1 as "GDA 1" COLOR_GDA_1
participant eDiag_FA as "e-Diagnose Fachanwendung" COLOR_DIAG_FA

autonumber
activate GDA_1 COLOR_GDA_1

== Liste abrufen ==

GDA_1 -> eDiag_FA: POST /[Condition|Procedure|AllergyIntolerance]/$list-read

activate eDiag_FA COLOR_DIAG_FA

eDiag_FA -> eDiag_FA: Prüfung auf bestehende Liste
alt Liste vorhanden
eDiag_FA -> eDiag_FA: Ermittlung des aktuellen Listenzustands
alt Liste enthält Einträge

note over eDiag_FA
Mindestens ein Listeneintrag vorhanden
end note

eDiag_FA -> eDiag_FA: Aufbereitung der Listeneinträge\nnew|changed → unchanged\nremoved → entfernen

eDiag_FA -> eDiag_FA: Prüfung auf verbleibende Einträge

alt Keine Einträge mehr vorhanden
eDiag_FA -> eDiag_FA: Setzt List.emptyReason = nilknown
eDiag_FA -> GDA_1: Collection-Bundle (leer)\nemptyReason = nilknown\n+ ETag für Optimistic Locking

else Einträge vorhanden
eDiag_FA -> GDA_1: Collection-Bundle\nmit Listeneinträgen\n+ ETag für Optimistic Locking
end

else Liste leer

alt list.emptyReason = notstarted
eDiag_FA -> GDA_1: Collection-Bundle (leer)\nemptyReason = notstarted\n+ ETag für Optimistic Locking

else list.emptyReason = nilknown
eDiag_FA -> GDA_1: Collection-Bundle (leer)\nemptyReason = nilknown\n+ ETag für Optimistic Locking
end
end
else Liste nicht vorhanden
eDiag_FA -> eDiag_FA: Erzeugt leere Liste mit List.emptyReason = notstarted
eDiag_FA -> GDA_1: Collection-Bundle (leer)\nemptyReason = notstarted\n+ ETag für Optimistic Locking
end
deactivate eDiag_FA

GDA_1 -> GDA_1: Listeneinträge hinzufügen,\nändern oder entfernen

note over GDA_1
Die Liste kann anschließend
mittels $list-write persistiert werden.
end note

@enduml